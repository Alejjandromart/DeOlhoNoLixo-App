# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Security
BACKEND_API_KEY=your_backend_api_key_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
